        Time: 20.890162
    - rid: 60967987387039945
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 32.520542
    - rid: 60967987387039946
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 27.85355
    - rid: 60967987387039947
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 37.653927
    - rid: 60967987387039948
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 45.135563
    - rid: 60967987387039949
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 5.9122114
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "No fue solo el dolor, tampoco el vac\xEDo que deja la muerte. "
          NormalText: 
    - rid: 60967987387039950
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 14.033904
    - rid: 60967987387039951
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 29.790018
    - rid: 631314752231178433
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 1.108466
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "La noche que enterr\xE9 a mi viejo, algo regres\xF3 conmigo"
          NormalText: 
