    - rid: 60967987387039931
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 0
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "La noche que enterr\xE9 a mi padre, algo regres\xF3 conmigo"
          NormalText: 
    - rid: 60967987387039933
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 7.7637095
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Los m\xE9dicos insistieron en que se trataba de una extra\xF1a
            enfermedad."
          NormalText: 
    - rid: 60967987387039935
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 12.001618
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Hablaban de alucinaciones, p\xE9rdida de visi\xF3n, mareos y
            episodios de paranoia."
          NormalText: 
    - rid: 60967987387039936
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 17.9069
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Dec\xEDan que las voces que \xE9l escuchaba y las sombras que
            ve\xEDa eran simples delirios de una mente rota."
          NormalText: 
    - rid: 60967987387039937
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 24.43745
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Pero yo estuve all\xED."
          NormalText: 
    - rid: 60967987387039938
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 26.1743
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Vi como el miedo lo consum\xEDa vivo. "
          NormalText: 
    - rid: 60967987387039939
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 29.23115
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Jam\xE1s podr\xE9 olvidar su expresi\xF3n de terror que qued\xF3
            grabado en su rostro antes de morir. "
          NormalText: 
    - rid: 60967987387039940
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 35.06696
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Todav\xEDa no me animo a ir a su casa, pero necesito esas escrituras."
          NormalText: 
    - rid: 60967987387039941
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 39.304867
        Narrator: 
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: Solo voy a entrar, recoger los papeles e irme.
          NormalText: 
    - rid: 60967987387039942
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 2.4836926
    - rid: 60967987387039943
      type: {class: DialogueAsset/SubtitleBreak, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
